{
  "name": "newworld-desktop",
  "productName": "New World Desktop",
  "version": "1.1.0",
  "description": "Shares the displays of a Windows PC with New World on Meta Quest, over the local network only.",
  "author": "KORE META",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "fake-headset": "node tools/fake-headset.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.koremeta.newworld.desktop",
    "productName": "New World Desktop",
    "copyright": "KORE META",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "publish": null,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "NewWorldDesktop"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "New World Desktop",
      "include": "build/installer.nsh",
      "artifactName": "NewWorldDesktop-Setup-${version}.${ext}"
    }
  }
}
