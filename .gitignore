# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/*
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/UIElementsSchema/

# Auto-generated cache in Assets folder
/[Aa]ssets/[Ss]ceneDependencyCache*

# ---- Study Everywhere additions ----
/.utmp/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE
.vscode/
.idea/

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Office lock files
~$*

# Skybox tool scratch (request flags and test files written by the editor/agents)
/Tools/Skybox/*.request

# Cat server (Tools/CatServer): dependencies and local secrets
Tools/CatServer/node_modules/
Tools/CatServer/.env
Tools/CatServer/unity-client.json

# Cat server client config (holds the app token)
/Tools/CatServer/unity-client.json
Tools/Skybox/out/evercrest-terrain-*.bin

# Relay address + app token, written by the builders from Tools/CatServer/unity-client.json
Assets/StudyEverywhere/Resources/VoiceRelay.json
Assets/StudyEverywhere/Resources/VoiceRelay.json.meta

# Remote-attachment scratch
.codex-remote-attachments/

# Haven Time Tide: raw Poly Haven (CC0) downloads, re-fetched by docs/haven-time-tide/ASSET-PROVENANCE.md; only baked results are committed
/Assets/StudyEverywhere/HavenTide/PolyHaven/
/Assets/StudyEverywhere/HavenTide/PolyHaven.meta

# Vegetation: LOD sets rebuild from Tools/Vegetation/source with veg_optimise.py
/Tools/Vegetation/optimised/

# Solace performance sets: Hunyuan scans (80 MB each) and Blender working files
/Tools/History/perf/scan/
/Tools/History/perf/inspect/
/Tools/History/perf/out/**/*.blend
/Tools/History/perf/out/**/*.blend1
/Tools/History/perf/out/**/*.txt

# ---- NewWorld AI (public repo): kept on disk for the build, never published ----
# Unity Asset Store packs: their licence allows them inside a built app, not as files in a public repository.
# The release APK has them; to open the premium places in the Editor, import them from the Asset Store.
/Assets/PolygonNature/
/Assets/PolygonNature.meta
/Assets/WorldMaterialsFree/
/Assets/WorldMaterialsFree.meta
/Assets/Yughues Free Palm Trees/
/Assets/Yughues Free Palm Trees.meta
/Assets/Mirza Beig/
/Assets/Mirza Beig.meta
# Wit.ai (Meta Voice SDK) configuration: holds the app's Wit token. Make your own at wit.ai (see README).
/Assets/VoiceSDK.asset
/Assets/VoiceSDK.asset.meta
/ProjectSettings/wit.config
/ProjectSettings/WitConfigExports/
# Licensed files the open places use: in the release APK, not published as files.
#   Artlist music (Orbit's four tracks, the lobby song); NoxSound "Nature - Essentials" (Asset Store) sea, fire and wind;
#   Pixabay frog calls (may not be redistributed on their own); Yughues palms merged into Seabreeze's meshes; BOXEN font.
/Assets/StudyEverywhere/Orbit/Audio/Beyond the Signal.mp3*
/Assets/StudyEverywhere/Orbit/Audio/Gravity Drift.mp3*
/Assets/StudyEverywhere/Orbit/Audio/Midnight Protocol.mp3*
/Assets/StudyEverywhere/Orbit/Audio/Silent Vector.mp3*
/Assets/StudyEverywhere/Lobby/Audio/A Little Room To Breathe_LobbySong.mp3*
/Assets/StudyEverywhere/Seabreeze/Audio/Sea.wav*
/Assets/StudyEverywhere/Seabreeze/Audio/Campfire.wav*
/Assets/StudyEverywhere/Seabreeze/Audio/Calm wind.wav*
/Assets/StudyEverywhere/Seoul/Audio/Frogs/*.wav*
/Assets/StudyEverywhere/Seabreeze/Meshes/Seabreeze palms *.asset*
/Assets/StudyEverywhere/UI/Fonts/BOXEN*
# working folders: preview renders, the pruning lists, the pruning tool itself
/Tools/Skybox/
/Tools/Prune/
/Assets/StudyEverywhere/Editor/NewWorldAIPrune.cs*

# Kore Meta's Real Objects SDK: not used by the open places, not published
/Packages/com.koremeta.realobjects/
# the editor's logs and temporary files
/Temp/
/Logs/
/UserSettings/

# The release build and the desktop installer are committed (Git LFS), nothing else under Builds/ or dist/
!/Builds/NewWorld-AI.apk
!/Tools/DesktopCompanion/dist/NewWorldDesktop-Setup-1.1.0.exe
