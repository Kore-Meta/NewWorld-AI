  leftController: {fileID: 1881960970}
  demoStage: {fileID: 2130323002}
  watch: {fileID: 249646664}
  handLessons:
  - id: pinch
    title: Point and pinch
    body: 'Point at a button with an open hand: a ray comes from your hand. Pinch your thumb and index finger together to press.'
  - id: touch
    title: Touch
    body: Or press a button directly with your index fingertip, just like a real one.
  - id: grab
    title: Grab
    body: Close your hand round a cup, a book or a panel's edge to pick it up. Open your hand to let go.
  - id: teleport
    title: Teleport
    body: 'Turn your palm up and hold out your thumb and index finger, the other fingers curled: an arc appears. Pinch to aim, move your hand to turn the arrow, and let go to go there.'
  - id: turn
    title: Turn
    body: 'Tap your thumb on the side of your index finger: near the knuckle to turn right, near the fingertip to turn left.'
  - id: menu
    title: Menu
    body: Tap the watch on your left wrist with a finger of your other hand to open the menu.
  controllerLessons:
  - id: pinch
    title: Point and press
    body: Point the controller at a button and pull the trigger (under your index finger) to press it.
  - id: grab
    title: Grab
    body: Squeeze the grip button (under your middle finger) to pick something up; let go to drop it.
  - id: teleport
    title: Walk and teleport
    body: 'Push the left thumbstick to walk. To jump ahead, push the right thumbstick forward: an arc shows where you will land; let go to go there.'
  - id: turn
    title: Turn
    body: Flick the right thumbstick left or right to turn; pull it back to turn round.
  - id: menu
    title: Menu
    body: Press the menu button or Y on the left controller to open the menu.
  charactersPerSecond: 40
  startDelay: 1.2
  dotOn: {r: 0.18431373, g: 0.31764707, b: 0.25490198, a: 1}
  dotOff: {r: 0.18431373, g: 0.31764707, b: 0.25490198, a: 0.25}
